diff --git a/shop-login.html b/shop-login.html
new file mode 100644
index 0000000..cd26d6a
--- /dev/null
+++ b/shop-login.html
@@ -0,0 +1,99 @@
+<!DOCTYPE html>
+<html lang="th">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>เข้าสู่ระบบร้านค้า | Nimit Delivery</title>
+<link rel="icon" href="/icon-192.png">
+<style>
+:root{--primary:#0c4aa6;--primary-dark:#083570;--primary-light:#e8f0fe;--text:#0f172a;--subtext:#64748b}
+*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
+body{background:#fff;min-height:100vh;display:flex;flex-direction:column}
+.hero{background:linear-gradient(135deg,var(--primary),var(--primary-dark));padding:44px 24px 52px;border-radius:0 0 32px 32px;color:#fff}
+.hero h1{font-size:26px;font-weight:800;margin-bottom:6px}.hero p{font-size:15px;opacity:.85}
+.box{padding:24px 20px;flex:1;max-width:480px;width:100%;margin:0 auto}
+.label{font-size:13px;font-weight:700;color:var(--subtext);margin-bottom:8px}
+.inp{width:100%;height:56px;border:2px solid #e0e0e0;border-radius:16px;padding:0 20px;font-size:18px;outline:none}
+.inp:focus{border-color:var(--primary)}
+.btn{width:100%;height:56px;border:none;border-radius:16px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;font-size:17px;font-weight:800;margin-top:20px;cursor:pointer}
+.btn:disabled{background:#c5cfe8;cursor:not-allowed}
+.err{color:#e53935;font-size:13px;margin-top:10px;min-height:18px}
+.link{margin-top:16px;text-align:center;color:var(--primary);font-size:14px;font-weight:700;cursor:pointer}
+.note{margin-top:24px;text-align:center;color:var(--subtext);font-size:12.5px;line-height:1.6}
+.note a{color:var(--primary)}
+.shop{display:flex;align-items:center;gap:12px;border:2px solid #e2e8f0;border-radius:16px;padding:14px 16px;margin-top:10px;cursor:pointer;font-weight:700;color:var(--text)}
+.shop small{display:block;color:var(--subtext);font-weight:400;margin-top:2px}
+.hide{display:none}
+</style>
+</head>
+<body>
+<div class="hero"><h1>🏪 เข้าสู่ระบบร้านค้า</h1><p>ใช้เบอร์โทรที่ลงทะเบียนไว้กับร้าน</p></div>
+<div class="box">
+  <div id="s1">
+    <div class="label">เบอร์โทรร้านค้า</div>
+    <input class="inp" id="phone" type="tel" inputmode="numeric" placeholder="08X-XXX-XXXX" autocomplete="tel">
+    <button class="btn" id="b1" disabled>ขอรหัส OTP</button>
+  </div>
+  <div id="s2" class="hide">
+    <div class="label">กรอกรหัส OTP 6 หลัก</div>
+    <input class="inp" id="code" type="tel" inputmode="numeric" maxlength="6" placeholder="••••••" autocomplete="one-time-code" style="letter-spacing:10px;text-align:center">
+    <button class="btn" id="b2" disabled>ยืนยัน</button>
+    <div class="link" id="back">เปลี่ยนเบอร์</div>
+  </div>
+  <div id="s3" class="hide"><div class="label">เลือกร้านที่จะเข้า</div><div id="list"></div></div>
+  <div class="err" id="err"></div>
+  <div id="rc"></div>
+  <div class="note">การเข้าสู่ระบบถือว่ายอมรับ <a href="legal/shop-terms.html">ข้อกำหนด</a> และ <a href="legal/shop-privacy.html">นโยบายความเป็นส่วนตัว</a></div>
+</div>
+<script type="module">
+import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
+import { getFirestore, collection, getDocs, query, where } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
+import { getAuth, RecaptchaVerifier, signInWithPhoneNumber, signOut } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
+const firebaseConfig={apiKey:"AIzaSyCnBUk0ZKFcwMK0NyYkheux1xPt9bLYhr4",authDomain:"nimit-delivery.firebaseapp.com",projectId:"nimit-delivery",storageBucket:"nimit-delivery.firebasestorage.app",messagingSenderId:"233476256130",appId:"1:233476256130:web:62ba8f64ad0bf2f92c9f9b"};
+const app=initializeApp(firebaseConfig), db=getFirestore(app), auth=getAuth(app); auth.languageCode='th';
+const $=id=>document.getElementById(id);
+const norm=p=>{let d=String(p||'').replace(/\D/g,''); if(d.startsWith('66'))d='0'+d.slice(2); return d;};
+const next=new URLSearchParams(location.search).get('id')||'';
+let shops=[],phone='',conf=null,verifier=null;
+const err=m=>$('err').textContent=m||'';
+$('phone').addEventListener('input',()=>{$('b1').disabled=norm($('phone').value).length<9;err();});
+$('code').addEventListener('input',()=>{$('code').value=$('code').value.replace(/\D/g,'');$('b2').disabled=$('code').value.length!==6;if($('code').value.length===6)verify();});
+$('back').onclick=()=>{$('s2').classList.add('hide');$('s1').classList.remove('hide');$('code').value='';err();};
+async function findShops(p){
+  const col=collection(db,'shops'); const out=new Map();
+  for(const v of [p, p.replace(/^0/,'+66')]){ (await getDocs(query(col,where('phone','==',v)))).forEach(d=>out.set(d.id,d)); }
+  if(!out.size) (await getDocs(col)).forEach(d=>{ if(norm(d.data().phone)===p) out.set(d.id,d); });
+  return [...out.values()].map(d=>({id:d.id,slug:d.data().slug||d.id,name:d.data().name||'ร้านค้า',desc:d.data().desc||''}));
+}
+$('b1').onclick=async()=>{
+  err(); $('b1').disabled=true; $('b1').textContent='กำลังตรวจสอบ...';
+  try{
+    phone=norm($('phone').value); shops=await findShops(phone);
+    if(!shops.length){err('ไม่พบร้านที่ใช้เบอร์นี้ ติดต่อแอดมินเพื่อลงทะเบียนเบอร์ร้าน');return;}
+    if(!verifier){verifier=new RecaptchaVerifier(auth,'rc',{size:'invisible'});}
+    conf=await signInWithPhoneNumber(auth,'+66'+phone.slice(1),verifier);
+    $('s1').classList.add('hide');$('s2').classList.remove('hide');$('code').focus();
+  }catch(e){
+    const m={'auth/invalid-phone-number':'เบอร์ไม่ถูกต้อง','auth/too-many-requests':'ขอรหัสบ่อยเกินไป ลองใหม่ภายหลัง','auth/operation-not-allowed':'ระบบ OTP ยังไม่เปิดใช้งาน ติดต่อแอดมิน','auth/billing-not-enabled':'ระบบ OTP ยังไม่เปิดใช้งาน ติดต่อแอดมิน'}[e.code];
+    err(m||('ส่งรหัสไม่สำเร็จ ('+(e.code||e.message)+')')); try{verifier&&verifier.clear();}catch(_){} verifier=null;
+  }finally{$('b1').textContent='ขอรหัส OTP';$('b1').disabled=norm($('phone').value).length<9;}
+};
+async function verify(){
+  if($('b2').disabled&&$('code').value.length!==6)return; err(); $('b2').disabled=true;
+  try{
+    await conf.confirm($('code').value);
+    try{await signOut(auth);}catch(_){}   // ใช้ OTP แค่ยืนยันตัวตน ไม่เก็บ session ของ Firebase Auth
+    const slugs=[...new Set(shops.flatMap(s=>[s.id,s.slug]))];
+    localStorage.setItem('shopAuth',JSON.stringify({phone,slugs,ts:Date.now()}));
+    const hit=shops.find(s=>s.id===next||s.slug===next);
+    if(hit) return go(hit);
+    if(shops.length===1) return go(shops[0]);
+    $('s2').classList.add('hide');$('s3').classList.remove('hide');
+    $('list').innerHTML=''; shops.forEach(s=>{const d=document.createElement('div');d.className='shop';d.innerHTML='<span>🏪</span><div></div>';d.lastChild.textContent=s.name;const sm=document.createElement('small');sm.textContent=s.desc;d.lastChild.appendChild(sm);d.onclick=()=>go(s);$('list').appendChild(d);});
+  }catch(e){err(e.code==='auth/invalid-verification-code'?'รหัสไม่ถูกต้อง':e.code==='auth/code-expired'?'รหัสหมดอายุ ขอใหม่อีกครั้ง':'ยืนยันไม่สำเร็จ ('+(e.code||e.message)+')');$('code').value='';}
+}
+$('b2').onclick=verify;
+function go(s){location.replace('shop-admin.html?id='+encodeURIComponent(s.slug));}
+</script>
+</body>
+</html>
